# ============================================================
# WeChat Ingest System - environment example
#
# 用法：
#   cp .env.example .env
#   然后按你的环境填值
#
# 注意：
# 1. 当前项目的配置并没有完全环境变量化
# 2. 仍有一部分配置在 server/app/config.py、worker/app/config.py、send_report.py 中
# 3. 这个文件主要覆盖“已经支持环境变量”的部分
# ============================================================

# =========================
# Server admin auth
# =========================
WECHAT_ADMIN_PASSWORD=change_me_to_a_strong_password
WECHAT_ADMIN_SECRET=change_me_to_a_random_secret

# =========================
# Shared server/worker ingest auth
# Server 与 Worker 必须一致
# =========================
WECHAT_INGEST_WORKER_TOKEN=change_me_to_a_shared_worker_token

# =========================
# Worker runtime
# =========================
WECHAT_INGEST_SERVER_BASE_URL=http://127.0.0.1:8000/api/v1
WECHAT_INGEST_WORKER_ID=local-win-main
WECHAT_INGEST_BROWSER_STATE_PATH=./data/wechat_storage_state.json
WECHAT_INGEST_PERSISTENT_PROFILE_DIR=./data/chrome_profile
WECHAT_INGEST_HEADLESS=false
WECHAT_INGEST_POLL_INTERVAL_SECONDS=120
WECHAT_INGEST_HOMEPAGE_REFRESH_INTERVAL_SECONDS=1800
WECHAT_INGEST_DEBUG_SAVE_ARTIFACTS=false
WECHAT_INGEST_PARAM_CACHE_TTL_SECONDS=7200

# =========================
# LLM / report generation
# report_generator.py 优先读这里
# 如果没填，会尝试读取 ~/.openclaw/openclaw.json 中的 provider 配置
# =========================
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_CALL_TIMEOUT=600
DEEPSEEK_MODEL=deepseek-chat

# =========================
# WeChat Official Account draft publishing
# 如果不想在 wechat_official_account.json 里写，也可以用环境变量
# =========================
WECHAT_OFFICIAL_APPID=your_wechat_official_appid
WECHAT_OFFICIAL_APPSECRET=your_wechat_official_appsecret
WECHAT_OFFICIAL_ACCOUNT_NAME=your_wechat_official_account_name

# =========================
# OpenClaw notes
# =========================
# send_report.py / send_report.sh 依赖 openclaw CLI 发送 Telegram 消息

# 报告发送 / Web 链接
WECHAT_INGEST_REPORT_TARGET_CHAT=-5289939595
WECHAT_INGEST_LOGIN_ALERT_TARGET_CHAT=6820808476
WECHAT_INGEST_WEB_BASE_URL=http://127.0.0.1:8000
WECHAT_INGEST_AUTO_CREATE_WECHAT_DRAFT=true
WECHAT_INGEST_GENERATOR_TIMEOUT=900
WECHAT_INGEST_GENERATOR_RETRY_DELAYS=15,45,90
